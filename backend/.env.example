# Application Configuration
APP_PORT=8080
APP_ENV=development
# Public web URL; used to build links in emails
APP_BASE_URL=http://localhost:5173

# Multi-Tenancy (set to false for single-tenant projects)
MULTI_TENANT_ENABLED=true
# Must be a UUID. The default tenant is created at startup if it does not exist.
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001

# Database Connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=template_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Database Connection Pool
DB_POOL_MAX_OPEN=25
DB_POOL_MAX_IDLE=5

# Redis + background jobs (Asynq runs inside the API process)
REDIS_URL=redis://localhost:6379/0
ASYNQ_CONCURRENCY=10

# CORS Configuration (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# JWT / auth
JWT_SECRET=change-this-to-a-secure-value-in-production
# Access token lifetime in minutes (240 = 4 hours). Refresh tokens last REFRESH_TOKEN_TTL_HOURS.
ACCESS_TOKEN_TTL_MINUTES=240
REFRESH_TOKEN_TTL_HOURS=720

# Reverse proxies whose X-Forwarded-For is trusted for client IPs (comma-separated CIDRs).
# Leave empty for local development. Set to your proxy's network in production (e.g. Coolify),
# otherwise rate limiting sees every request as coming from the proxy.
TRUSTED_PROXIES=

# First-run admin: created only if no super_admin exists yet. Its email is pre-verified.
# Fill both in before the first start (password 8 to 72 characters), then remove
# BOOTSTRAP_ADMIN_PASSWORD after first use. Each key must appear only once in this file.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Email (SMTP). Defaults match the Mailpit container in docker-compose.yml.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@state55.local
# Set SKIP_EMAILS=true to send no email at all (for example while SMTP is not set up yet).
# - New accounts are created already verified (and get their member ID), and accounts that registered
#   earlier are verified automatically the next time they sign in.
# - Every other email (password reset, invitations) is written to the server log instead, including
#   its link, and shows as "Skipped" in the admin email log.
# Defaults to false. The app refuses to start with SKIP_EMAILS=true when APP_ENV=production.
SKIP_EMAILS=false

# File storage (MinIO). Leave MINIO_ENDPOINT empty to disable.
# Two buckets: public (anonymous read) and private (presigned URLs only).
MINIO_ENDPOINT=localhost:9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_PUBLIC_BUCKET=media-public
MINIO_PRIVATE_BUCKET=private
MINIO_PUBLIC_URL=http://localhost:9000
