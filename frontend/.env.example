# Backend API base URL, no trailing slash. In dev this defaults to http://localhost:8080 when empty.
VITE_BACKEND_URL=

# Optional: pin the tenant (a UUID). Leave empty to use the backend's default tenant.
VITE_TENANT_ID=

# Firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
